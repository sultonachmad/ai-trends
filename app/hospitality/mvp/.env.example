# Ttest copies these keys into backend/.env, the file the backend (and compose's backend service) reads.
NEXT_PUBLIC_APP_NAME=Ttest App

PREFAB_SECRET_KEY=change-me-in-production
PREFAB_CORS_ORIGINS=["http://localhost:3000"]

RBAC_SEED_ADMIN=false
RBAC_ADMIN_EMAIL=admin@example.com
RBAC_ADMIN_PASSWORD=



# --- PREFAB:email-contact ---
# SMTP configuration for the contact form email sender.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com
# For Gmail, use an App Password (not your account password):
#   https://support.google.com/accounts/answer/185833
PREFAB_SMTP_HOST=smtp.gmail.com
PREFAB_SMTP_PORT=587
PREFAB_SMTP_USER=
PREFAB_SMTP_PASSWORD=
PREFAB_CONTACT_RECIPIENT=

