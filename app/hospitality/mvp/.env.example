# Ttest copies these keys into backend/.env, the file the backend (and compose's backend service) reads.
NEXT_PUBLIC_APP_NAME=Ttest App

PREFAB_SECRET_KEY=change-me-in-production
PREFAB_CORS_ORIGINS=["http://localhost:3000"]
# Send the session cookie over HTTPS only. Keep false for local http://localhost;
# set true wherever the app is served over HTTPS.
PREFAB_SESSION_COOKIE_SECURE=false
# Development only: lets a signed-in tester send WhatsApp messages in "as a guest"
# from the Inbox page. Keep false anywhere real guests are served.
PREFAB_MESSAGING_SIMULATOR_ENABLED=false
# Development only: shows a "Simulate payment" button on pay links. Keep false
# anywhere real money is taken.
PREFAB_PAYMENT_SIMULATOR_ENABLED=false
# Address guests open pay links at, e.g. https://app.example.com
# Empty = the first address in PREFAB_CORS_ORIGINS.
PREFAB_FRONTEND_URL=

RBAC_SEED_ADMIN=false
RBAC_ADMIN_EMAIL=admin@example.com
RBAC_ADMIN_PASSWORD=



# --- PREFAB:email-contact ---
# SMTP configuration for the contact form email sender.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com
# For Gmail, use an App Password (not your account password):
#   https://support.google.com/accounts/answer/185833
PREFAB_SMTP_HOST=smtp.gmail.com
PREFAB_SMTP_PORT=587
PREFAB_SMTP_USER=
PREFAB_SMTP_PASSWORD=
PREFAB_CONTACT_RECIPIENT=

# --- PREFAB:llm-call ---
# LLM model for litellm (see https://docs.litellm.ai/docs/providers)
# Examples: openai/gpt-4o, bedrock/anthropic.claude-3-5-haiku-20241022-v1:0, anthropic/claude-sonnet-4-20250514
PREFAB_LLM_MODEL=openai/gpt-4o

# OpenAI API key (required for openai/* models; Bedrock models need
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION instead)
OPENAI_API_KEY=

# --- PREFAB:rag-base ---
# Qdrant vector database URL
PREFAB_QDRANT_URL=http://localhost:6333

# Qdrant collection name
PREFAB_RAG_COLLECTION=sendo_app

# Embedding model for litellm (see https://docs.litellm.ai/docs/embedding/supported_embedding)
# Examples: openai/text-embedding-3-small, bedrock/amazon.titan-embed-text-v2:0, cohere/embed-english-v3.0
PREFAB_EMBEDDING_MODEL=openai/text-embedding-3-small

# Max accepted upload size in bytes for POST /api/rag/upload (default 10 MiB).
# Raise for large PDFs; enforce a matching request-body limit at your reverse
# proxy for a complete ingress bound.
PREFAB_RAG_MAX_UPLOAD_BYTES=10485760

